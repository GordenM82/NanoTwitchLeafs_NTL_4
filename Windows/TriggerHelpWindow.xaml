<Window x:Class="NanoTwitchLeafs.Windows.TriggerHelpWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:p="clr-namespace:NanoTwitchLeafs.Properties" Title="{x:Static p:Resources.Window_TriggerHelp_Title}" Height="740" Width="900" MinHeight="520" MinWidth="640" ResizeMode="CanResize" WindowStartupLocation="CenterOwner" Background="{DynamicResource NtlBackgroundBrush}" Foreground="{DynamicResource NtlTextBrush}">
 <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Margin="4,0,4,14"><TextBlock x:Name="HelpHeading_TextBlock" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="HelpIntro_TextBlock" Margin="0,5,0,0" FontSize="14" Foreground="{DynamicResource NtlMutedTextBrush}" TextWrapping="Wrap"/></StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl x:Name="HelpSections_ItemsControl"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource NtlCardStyle}" Margin="0,0,0,12" Padding="18"><StackPanel><TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBlock Text="{Binding Body}" FontSize="14" LineHeight="21" TextWrapping="Wrap" Foreground="{DynamicResource NtlTextBrush}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
 </Grid>
</Window>
