<Window x:Class="NanoTwitchLeafs.Windows.ResponsesHelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:p="clr-namespace:NanoTwitchLeafs.Properties"
        xmlns:local="clr-namespace:NanoTwitchLeafs.Windows"
        mc:Ignorable="d"
        Title="{x:Static p:Resources.Window_ResponsesHelp_Title}" Height="440" Width="680" MinHeight="320" MinWidth="520" ResizeMode="CanResize" Background="{DynamicResource NtlBackgroundBrush}" Foreground="{DynamicResource NtlTextBrush}">
    <Grid Margin="18">
        <Border Style="{StaticResource NtlCardStyle}"><ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock Text="{x:Static p:Resources.Window_ResponsesHelp_Text}" TextWrapping="Wrap" Foreground="{DynamicResource NtlTextBrush}" Padding="4"/></ScrollViewer></Border>
    </Grid>
</Window>
