<Window x:Class="NanoTwitchLeafs.Windows.TriggerDetailWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit" xmlns:p="clr-namespace:NanoTwitchLeafs.Properties" Title="{x:Static p:Resources.Window_TriggerDetail_Title}" Height="840" Width="900" MinHeight="700" MinWidth="760" WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" Background="{DynamicResource NtlBackgroundBrush}" Foreground="{DynamicResource NtlTextBrush}">
 <Window.Resources>
  <Style x:Key="Card" TargetType="Border" BasedOn="{StaticResource NtlCardStyle}"><Setter Property="Margin" Value="0,0,0,12"/><Setter Property="Padding" Value="14"/></Style>
  <Style x:Key="Heading" TargetType="TextBlock"><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
  <Style x:Key="Choice" TargetType="RadioButton"><Setter Property="Foreground" Value="{DynamicResource NtlTextBrush}"/><Setter Property="MinWidth" Value="155"/><Setter Property="Margin" Value="0,3,10,5"/></Style>
  <Style x:Key="Number" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Width" Value="76"/><Setter Property="HorizontalContentAlignment" Value="Center"/></Style>
 </Window.Resources>
 <Grid Margin="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Label Content="{x:Static p:Resources.Window_TriggerDetail_Slider_Text}" Padding="0,0,10,0"/><Slider x:Name="OnOff_Slider" Width="44" Minimum="0" Maximum="1" SmallChange="1" BorderThickness="0" ValueChanged="Slider_ValueChanged" Background="#33E433"/></StackPanel>
   <Button x:Name="TriggerHelp_Button" Grid.Column="1" Content="{x:Static p:Resources.General_Button_Help}" MinWidth="88" MinHeight="36" Padding="14,7" Click="TriggerHelp_Button_Click"/>
  </Grid>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
   <Border Style="{StaticResource Card}"><StackPanel><TextBlock Style="{StaticResource Heading}" Text="{x:Static p:Resources.Window_TriggerDetail_Label_TriggerType}"/><WrapPanel>
    <RadioButton x:Name="Cmd_RadioButton" Style="{StaticResource Choice}" GroupName="Trigger" Content="{x:Static p:Resources.Window_TriggerDetail_RadioButton_Command}" IsChecked="True" Click="TriggerRadioButton_Click"/>
    <RadioButton x:Name="Keyword_RadioButton" Style="{StaticResource Choice}" GroupName="Trigger" Content="{x:Static p:Resources.Window_TriggerDetail_RadioButton_Keyword}" Click="TriggerRadioButton_Click"/>
    <RadioButton x:Name="UserColor_RadioButton" Style="{StaticResource Choice}" GroupName="Trigger" Content="{x:Static p:Resources.Window_TriggerDetail_RadioButton_UserColor}" Click="TriggerRadioButton_Click"/>
    <RadioButton x:Name="HypeRate_RadioButton" Style="{StaticResource Choice}" GroupName="Trigger" Content="HypeRate" Click="TriggerRadioButton_Click"/>
    <RadioButton x:Name="Follower_RadioButton" Style="{StaticResource Choice}" GroupName="Trigger" Content="{x:Static p:Resources.Window_TriggerDetail_RadioButton_NewFollower}" Click="TriggerRadioButton_Click"/>
    <RadioButton x:Name="HypeTrain_RadioButton" Style="{StaticResource Choice}" GroupName="Trigger" Content="{x:Static p:Resources.Window_TriggerDetail_RadioButton_HypeTrain}" Click="TriggerRadioButton_Click"/>
    <RadioButton x:Name="Raid_RadioButton" Style="{StaticResource Choice}" GroupName="Trigger" Content="{x:Static p:Resources.Window_TriggerDetail_RadioButton_Raid}" Click="TriggerRadioButton_Click"/>
    <RadioButton x:Name="Bits_RadioButton" Style="{StaticResource Choice}" GroupName="Trigger" Content="{x:Static p:Resources.Window_TriggerDetail_RadioButton_Bits}" Click="TriggerRadioButton_Click"/>
    <RadioButton x:Name="Channelpoints_RadioButton" Style="{StaticResource Choice}" GroupName="Trigger" Content="{x:Static p:Resources.Window_TriggerDetail_RadioButton_ChannelPoints}" Click="TriggerRadioButton_Click"/>
    <RadioButton x:Name="Donation_RadioButton" Style="{StaticResource Choice}" GroupName="Trigger" Content="{x:Static p:Resources.Window_TriggerDetail_RadioButton_Donation}" Click="TriggerRadioButton_Click"/>
    <RadioButton x:Name="NewSub_RadioButton" Style="{StaticResource Choice}" GroupName="Trigger" Content="{x:Static p:Resources.Window_TriggerDetail_RadioButton_NewSubscriber}" Click="TriggerRadioButton_Click"/>
    <RadioButton x:Name="Resub_RadioButton" Style="{StaticResource Choice}" GroupName="Trigger" Content="{x:Static p:Resources.Window_TriggerDetail_RadioButton_Resub}" Click="TriggerRadioButton_Click"/>
    <RadioButton x:Name="Giftsub_RadioButton" Style="{StaticResource Choice}" GroupName="Trigger" Content="{x:Static p:Resources.Window_TriggerDetail_RadioButton_GiftSub}" Click="TriggerRadioButton_Click"/>
    <RadioButton x:Name="AnonGiftSub_RadioButton" Style="{StaticResource Choice}" GroupName="Trigger" Content="{x:Static p:Resources.Window_TriggerDetail_RadioButton_AnonGiftSub}" Click="TriggerRadioButton_Click"/>
    <RadioButton x:Name="GiftBomb_RadioButton" Style="{StaticResource Choice}" GroupName="Trigger" Content="{x:Static p:Resources.Window_TriggerDetail_RadioButton_GiftBomb}" Click="TriggerRadioButton_Click"/>
    <RadioButton x:Name="AnonGiftBomb_RadioButton" Style="{StaticResource Choice}" GroupName="Trigger" Content="{x:Static p:Resources.Window_TriggerDetail_RadioButton_AnonGiftBomb}" Click="TriggerRadioButton_Click"/>
   </WrapPanel></StackPanel></Border>
   <Border Style="{StaticResource Card}"><StackPanel><TextBlock Style="{StaticResource Heading}" Text="{x:Static p:Resources.Window_TriggerDetail_Label_CmdKeyword}"/><TextBox x:Name="CommandKeyword_Textbox" AutomationProperties.HelpText="Command or Keyword"/><Border x:Name="Channelpoints_Grid" Margin="0,10,0,0" Padding="12" CornerRadius="6" Background="{DynamicResource NtlSurfaceRaisedBrush}" BorderBrush="{DynamicResource NtlBorderBrush}" BorderThickness="1" Visibility="Collapsed"><TextBlock x:Name="channelPointsDetection_Label" TextWrapping="Wrap" Text="{x:Static p:Resources.Window_TriggerDetail_Label_NoRewardDetected}" Foreground="#E5484D"/></Border></StackPanel></Border>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Style="{StaticResource Heading}" Text="{x:Static p:Resources.Window_TriggerDetail_RadioButton_Effect}"/><StackPanel Orientation="Horizontal" Margin="0,0,0,8"><RadioButton x:Name="Effect_RadioButton" GroupName="Effect" Content="{x:Static p:Resources.Window_TriggerDetail_RadioButton_Effect}" IsChecked="True" Click="EffectRadioButton_Click" Margin="0,0,24,0"/><RadioButton x:Name="Color_RadioButton" GroupName="Effect" Content="{x:Static p:Resources.Window_TriggerDetail_RadioButton_Color}" Click="EffectRadioButton_Click"/></StackPanel><Grid><ComboBox x:Name="Effect_ComboBox"/><xctk:ColorPicker x:Name="ColorPicker" IsEnabled="False" Height="36" Background="{DynamicResource NtlInputBrush}" Foreground="{DynamicResource NtlTextBrush}" BorderBrush="{DynamicResource NtlBorderBrush}" DropDownBackground="{DynamicResource NtlSurfaceRaisedBrush}" DropDownBorderBrush="{DynamicResource NtlBorderBrush}" TabBackground="{DynamicResource NtlSurfaceRaisedBrush}" TabForeground="{DynamicResource NtlTextBrush}" HeaderBackground="{DynamicResource NtlInputBrush}" HeaderForeground="{DynamicResource NtlTextBrush}"/></Grid></StackPanel></Border>
    <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Style="{StaticResource Heading}" Text="{x:Static p:Resources.Window_TriggerDetail_Label_SoundEffect}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="SoundFilePath_Textbox" IsReadOnly="True" TextChanged="SoundFilePath_Textbox_TextChanged"/><Button x:Name="SelectSoundFilePath_Button" Grid.Column="1" Margin="8,0,0,0" MinWidth="130" Content="{x:Static p:Resources.Window_TriggerDetail_Button_SelectFile}" Click="SelectSoundFilePath_Button_Click"/></Grid><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Label Content="{x:Static p:Resources.Window_TriggerDetail_Label_Volume}" Padding="0,0,10,0"/><TextBox x:Name="Volume_Textbox" Style="{StaticResource Number}" Text="50" IsEnabled="False"/></StackPanel></StackPanel></Border>
   </Grid>
   <Border Style="{StaticResource Card}"><StackPanel><TextBlock Style="{StaticResource Heading}" Text="{x:Static p:Resources.Window_TriggerDetail_Label_Options}"/><WrapPanel Margin="0,0,0,10">
    <StackPanel Margin="0,0,22,8"><Label Content="{x:Static p:Resources.Window_TriggerDetail_Label_Duration}" Padding="0,0,0,4"/><TextBox x:Name="Duration_Textbox" Style="{StaticResource Number}" Text="10"/></StackPanel>
    <StackPanel Margin="0,0,22,8"><Label Content="{x:Static p:Resources.Window_TriggerDetail_Label_Amount}" Padding="0,0,0,4"/><TextBox x:Name="Amount_Textbox" Style="{StaticResource Number}" Text="0" IsEnabled="False"/></StackPanel>
    <StackPanel Margin="0,0,22,8"><Label Content="{x:Static p:Resources.Window_TriggerDetail_Label_Brightness}" Padding="0,0,0,4"/><TextBox x:Name="Brightness_Textbox" Style="{StaticResource Number}" Text="50"/></StackPanel>
    <StackPanel Margin="0,0,22,8"><Label Content="{x:Static p:Resources.Window_TriggerDetail_Label_Cooldown}" Padding="0,0,0,4"/><TextBox x:Name="Cooldown_Textbox" Style="{StaticResource Number}" Text="0"/></StackPanel>
   </WrapPanel><Grid x:Name="DonationProvider_Grid" Visibility="Collapsed" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions><Label x:Name="DonationProvider_Label" Padding="0,0,12,0"/><ComboBox x:Name="DonationProvider_ComboBox" Grid.Column="1"><ComboBoxItem Tag="All"/><ComboBoxItem Tag="Streamlabs" Content="Streamlabs"/><ComboBoxItem Tag="StreamElements" Content="StreamElements"/></ComboBox></Grid><WrapPanel><CheckBox x:Name="Viponly_Checkbox" Content="{x:Static p:Resources.Window_TriggerDetail_Checkbox_Vip}" Margin="0,0,24,4" Click="Checkbox_Click"/><CheckBox x:Name="Subonly_Checkbox" Content="{x:Static p:Resources.Window_TriggerDetail_Checkbox_Sub}" Margin="0,0,24,4" Click="Checkbox_Click"/><CheckBox x:Name="Modonly_Checkbox" Content="{x:Static p:Resources.Window_TriggerDetail_Checkbox_Mod}" Margin="0,0,24,4" Click="Checkbox_Click"/></WrapPanel><TextBlock x:Name="Vipsubmod_Textbox" Margin="0,5,0,0" TextWrapping="Wrap" Foreground="{DynamicResource NtlMutedTextBrush}"/></StackPanel></Border>
   <GroupBox x:Name="TargetDevices_GroupBox" Margin="0,0,0,6" Padding="12"><StackPanel><CheckBox x:Name="AllDevices_CheckBox" IsChecked="True" FontWeight="SemiBold" Margin="0,0,0,10" Checked="AllDevices_CheckBox_Changed" Unchecked="AllDevices_CheckBox_Changed"/><WrapPanel Margin="0,0,0,10"><Label x:Name="DeviceGroup_Label" Padding="0,0,8,0"/><ComboBox x:Name="DeviceGroup_ComboBox" Width="220" DisplayMemberPath="Name"/><Button x:Name="ApplyDeviceGroup_Button" Margin="8,0,0,0" Click="ApplyDeviceGroup_Button_Click"/><Button x:Name="ManageDeviceGroups_Button" Margin="8,0,0,0" Click="ManageDeviceGroups_Button_Click"/><TextBlock x:Name="NoDeviceGroups_TextBlock" Foreground="{DynamicResource NtlMutedTextBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/></WrapPanel><ItemsControl x:Name="TargetDevices_ItemsControl"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></StackPanel></GroupBox>
  </StackPanel></ScrollViewer>
  <Button x:Name="Save_Button" Grid.Row="2" Content="{x:Static p:Resources.Window_Responses_Button_Save}" Style="{StaticResource NtlPrimaryButtonStyle}" Margin="0,14,0,0" MinHeight="42" MinWidth="190" Click="Save_Button_Click" HorizontalAlignment="Center"/>
 </Grid>
</Window>
