<Window x:Name="Input_Dialog_Window" x:Class="NanoTwitchLeafs.Windows.InputDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:p="clr-namespace:NanoTwitchLeafs.Properties"
        mc:Ignorable="d"
        Title="{x:Static p:Resources.Window_NanoDeviceInput_Title}" Height="180" Width="480" MinWidth="400" ResizeMode="CanResize" WindowStartupLocation="CenterOwner" Background="{DynamicResource NtlBackgroundBrush}" Foreground="{DynamicResource NtlTextBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock x:Name="inputDialog_Label" TextWrapping="Wrap" Text="{x:Static p:Resources.Window_NanoDeviceInput_Text}" Foreground="{DynamicResource NtlTextBrush}" Margin="0,0,0,10" />
        <TextBox x:Name="inputDialog_TextBox" Grid.Row="1" TextWrapping="NoWrap" Text="" VerticalContentAlignment="Center" MinHeight="36" Foreground="{DynamicResource NtlTextBrush}" Background="{DynamicResource NtlInputBrush}" />
        <Button x:Name="inputDialog_Button" Grid.Row="2" Content="{x:Static p:Resources.General_Button_OK}" HorizontalAlignment="Right" MinWidth="100" Margin="0,12,0,0" Click="InputDialog_Button_Click" />
    </Grid>
</Window>
