<Window x:Name="App_Info_Window" x:Class="NanoTwitchLeafs.Windows.AppInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:fa="http://schemas.fontawesome.com/icons/svg"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:p="clr-namespace:NanoTwitchLeafs.Properties"
        mc:Ignorable="d"
        Title="{x:Static p:Resources.Window_AppInfo_Title}" Height="555" Width="430"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Canvas Margin="10">
        <Image Height="133" Canvas.Left="-137" Canvas.Top="150" Width="361"
               Source="/NanoTwitchLeafs;component/Assets/nanotwitchleafs_logo.png"
               RenderTransformOrigin="0.5,0.5">
            <Image.RenderTransform>
                <TransformGroup>
                    <ScaleTransform />
                    <SkewTransform />
                    <RotateTransform Angle="-90" />
                    <TranslateTransform />
                </TransformGroup>
            </Image.RenderTransform>
        </Image>

        <Label Content="{x:Static p:Resources.Window_AppInfo_Label_Version}"
               Canvas.Left="105" Canvas.Top="2" Width="290"
               HorizontalContentAlignment="Center" />
        <Label x:Name="version_Label" Content="x.x.x"
               Canvas.Left="105" Canvas.Top="28" Width="290"
               HorizontalContentAlignment="Center" />

        <TextBlock x:Name="originalDeveloperTitle_TextBlock"
                   Canvas.Left="105" Canvas.Top="62" Width="290"
                   TextAlignment="Center" />
        <TextBlock Text="Locxion – Markus Bender"
                   Canvas.Left="105" Canvas.Top="84" Width="290"
                   TextAlignment="Center" />

        <TextBlock x:Name="maintainerTitle_TextBlock"
                   Canvas.Left="105" Canvas.Top="112" Width="290"
                   TextAlignment="Center" />
        <TextBlock Text="GordenM82"
                   Canvas.Left="105" Canvas.Top="134" Width="290"
                   TextAlignment="Center" />

        <fa:ImageAwesome Icon="Brands_Discord" Foreground="#FF8B9BD4"
                         Canvas.Left="122" Canvas.Top="165" Height="25" Width="25" />
        <Button x:Name="discord_Button" Canvas.Left="155" Canvas.Top="163"
                Width="220" Height="27" Click="Discord_Button_Click" />

        <fa:ImageAwesome Icon="Brands_Github" Foreground="#FF8B9BD4"
                         Canvas.Left="122" Canvas.Top="198" Height="25" Width="25" />
        <Button x:Name="originalGithub_Button" Canvas.Left="155" Canvas.Top="196"
                Width="220" Height="27" Click="OriginalGithub_Button_Click" />

        <fa:ImageAwesome Icon="Brands_Github" Foreground="#FF8B9BD4"
                         Canvas.Left="122" Canvas.Top="231" Height="25" Width="25" />
        <Button x:Name="ntl4Github_Button" Canvas.Left="155" Canvas.Top="229"
                Width="220" Height="27" Click="Ntl4Github_Button_Click" />

        <Button x:Name="originalFeedback_Button" Canvas.Left="115" Canvas.Top="272"
                Width="270" Height="27" Click="OriginalFeedback_Button_Click" />
        <Button x:Name="ntl4Feedback_Button" Canvas.Left="115" Canvas.Top="305"
                Width="270" Height="27" Click="Ntl4Feedback_Button_Click" />

        <TextBlock Text="{x:Static p:Resources.General_Label_Translator}"
                   Canvas.Left="105" Canvas.Top="349" Width="290"
                   TextAlignment="Center" />
        <TextBlock x:Name="aiAssistance_TextBlock"
                   Canvas.Left="105" Canvas.Top="375" Width="290"
                   TextAlignment="Center" TextWrapping="Wrap" />
        <TextBlock Text="Special thanks to Eric Bach &lt;3"
                   Canvas.Left="105" Canvas.Top="409" Width="290"
                   TextAlignment="Center" />

        <TextBlock x:Name="association_TextBlock"
                   Canvas.Left="105" Canvas.Top="440" Width="290" Height="65"
                   TextAlignment="Center" TextWrapping="Wrap" />
    </Canvas>
</Window>
