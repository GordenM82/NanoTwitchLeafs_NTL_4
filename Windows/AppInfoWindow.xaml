<Window x:Name="App_Info_Window" x:Class="NanoTwitchLeafs.Windows.AppInfoWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:fa="http://schemas.fontawesome.com/icons/svg" xmlns:p="clr-namespace:NanoTwitchLeafs.Properties"
 Title="{x:Static p:Resources.Window_AppInfo_Title}" Height="650" Width="620" MinHeight="560" MinWidth="540"
 ResizeMode="CanResize" WindowStartupLocation="CenterOwner" Background="{DynamicResource NtlBackgroundBrush}">
 <Grid Margin="12">
  <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Style="{StaticResource NtlCardStyle}" Margin="0,0,16,0">
   <Image Source="/NanoTwitchLeafs;component/Assets/nanotwitchleafs_logo.png" Stretch="Uniform" Margin="4">
    <Image.LayoutTransform><RotateTransform Angle="-90"/></Image.LayoutTransform>
   </Image>
  </Border>
  <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
   <StackPanel>
    <TextBlock Text="NanoTwitchLeafs 4" FontSize="24" FontWeight="SemiBold"/>
    <StackPanel Orientation="Horizontal" Margin="0,4,0,20"><TextBlock Text="{x:Static p:Resources.Window_AppInfo_Label_Version}" Foreground="{DynamicResource NtlMutedTextBrush}"/><Label x:Name="version_Label" Content="x.x.x" Padding="6,0" FontWeight="SemiBold"/></StackPanel>
    <Border Style="{StaticResource NtlCardStyle}" Margin="0,0,0,14"><StackPanel>
     <TextBlock x:Name="originalDeveloperTitle_TextBlock" Foreground="{DynamicResource NtlMutedTextBrush}"/><TextBlock Text="Locxion – Markus Bender" FontSize="15" Margin="0,2,0,12"/>
     <TextBlock x:Name="maintainerTitle_TextBlock" Foreground="{DynamicResource NtlMutedTextBrush}"/><TextBlock Text="GordenM82" FontSize="15" Margin="0,2,0,0"/>
    </StackPanel></Border>
    <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
     <Button x:Name="discord_Button" Grid.ColumnSpan="2" Margin="0,0,0,8" Click="Discord_Button_Click"/>
     <Button x:Name="originalGithub_Button" Grid.Row="1" Margin="0,0,4,8" Click="OriginalGithub_Button_Click"/><Button x:Name="ntl4Github_Button" Grid.Row="1" Grid.Column="1" Margin="4,0,0,8" Click="Ntl4Github_Button_Click"/>
     <Button x:Name="originalFeedback_Button" Grid.Row="2" Margin="0,0,4,0" Click="OriginalFeedback_Button_Click"/><Button x:Name="ntl4Feedback_Button" Grid.Row="2" Grid.Column="1" Margin="4,0,0,0" Click="Ntl4Feedback_Button_Click"/>
    </Grid>
    <Border Style="{StaticResource NtlCardStyle}"><StackPanel>
     <TextBlock Text="{x:Static p:Resources.General_Label_Translator}" TextAlignment="Center" Margin="0,0,0,8"/>
     <TextBlock x:Name="aiAssistance_TextBlock" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,8"/>
     <TextBlock Text="Special thanks to Eric Bach &lt;3" TextAlignment="Center" Margin="0,0,0,12"/>
     <TextBlock x:Name="association_TextBlock" Foreground="{DynamicResource NtlMutedTextBrush}" TextAlignment="Center" TextWrapping="Wrap"/>
    </StackPanel></Border>
   </StackPanel>
  </ScrollViewer>
 </Grid>
</Window>
