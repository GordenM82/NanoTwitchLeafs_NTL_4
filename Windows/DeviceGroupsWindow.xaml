<Window x:Class="NanoTwitchLeafs.Windows.DeviceGroupsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NanoTwitchLeafs" Height="500" Width="720" MinHeight="450" MinWidth="660" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Background="{DynamicResource NtlBackgroundBrush}" Foreground="{DynamicResource NtlTextBrush}">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="38" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="Heading_TextBlock" Grid.ColumnSpan="3" FontSize="22" FontWeight="SemiBold" Margin="4,0,0,12" />

        <GroupBox x:Name="Groups_GroupBox" Grid.Row="1" Grid.Column="0" Foreground="{DynamicResource NtlTextBrush}">
            <ListBox x:Name="Groups_ListBox" SelectionChanged="Groups_ListBox_SelectionChanged" DisplayMemberPath="Name" />
        </GroupBox>

        <GroupBox x:Name="EditGroup_GroupBox" Grid.Row="1" Grid.Column="2" Foreground="{DynamicResource NtlTextBrush}">
            <DockPanel Margin="6">
                <StackPanel DockPanel.Dock="Top">
                    <Label x:Name="GroupName_Label" Padding="0,0,0,3" />
                    <TextBox x:Name="GroupName_TextBox" Margin="0,0,0,10" />
                    <Label x:Name="GroupDevices_Label" Padding="0,0,0,3" />
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="GroupDevices_ItemsControl" Foreground="{DynamicResource NtlTextBrush}" />
                </ScrollViewer>
            </DockPanel>
        </GroupBox>

        <WrapPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button x:Name="NewGroup_Button" Click="NewGroup_Button_Click" Margin="4,0" />
            <Button x:Name="SaveGroup_Button" Click="SaveGroup_Button_Click" Margin="4,0" />
            <Button x:Name="DeleteGroup_Button" Click="DeleteGroup_Button_Click" Margin="4,0" />
            <Button x:Name="Help_Button" Click="Help_Button_Click" Margin="4,0" />
            <Button x:Name="Close_Button" Click="Close_Button_Click" Margin="4,0" />
        </WrapPanel>
    </Grid>
</Window>
