<Window x:Class="NanoTwitchLeafs.Windows.DeviceGroupsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NanoTwitchLeafs" Height="430" Width="620" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="38" />
        </Grid.RowDefinitions>

        <GroupBox x:Name="Groups_GroupBox" Grid.Column="0">
            <ListBox x:Name="Groups_ListBox" SelectionChanged="Groups_ListBox_SelectionChanged" DisplayMemberPath="Name" />
        </GroupBox>

        <GroupBox x:Name="EditGroup_GroupBox" Grid.Column="2">
            <DockPanel Margin="6">
                <StackPanel DockPanel.Dock="Top">
                    <Label x:Name="GroupName_Label" Padding="0,0,0,3" />
                    <TextBox x:Name="GroupName_TextBox" Height="24" Margin="0,0,0,8" />
                    <Label x:Name="GroupDevices_Label" Padding="0,0,0,3" />
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="GroupDevices_ItemsControl" />
                </ScrollViewer>
            </DockPanel>
        </GroupBox>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button x:Name="NewGroup_Button" Click="NewGroup_Button_Click" Padding="8,2" Margin="4,0" />
            <Button x:Name="SaveGroup_Button" Click="SaveGroup_Button_Click" Padding="8,2" Margin="4,0" />
            <Button x:Name="DeleteGroup_Button" Click="DeleteGroup_Button_Click" Padding="8,2" Margin="4,0" />
            <Button x:Name="Close_Button" Click="Close_Button_Click" Padding="8,2" Margin="4,0" />
        </StackPanel>
    </Grid>
</Window>
